# Copie este arquivo para .env no servidor e preencha com seus valores reais:
#   cp .env.example .env

# Porta exposta no servidor (http://IP_DA_ORACLE:8745)
APP_PORT=8745

# Fuso horário dos logs e carimbos de atualização
TZ=America/Manaus

# Usuário administrador inicial (usado apenas na 1ª vez que subir sem users.json)
ADMIN_USER=admin
ADMIN_PASSWORD=TroqueEstaSenhaForte123

# Frase secreta longa e aleatória para assinar os cookies de sessão
# (dica para gerar no Linux: openssl rand -hex 32)
SESSION_SECRET=troque-por-uma-chave-aleatoria-longa-aqui
